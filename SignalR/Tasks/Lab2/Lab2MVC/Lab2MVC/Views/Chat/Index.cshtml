<div class="container" style="max-width: 900px;">

    <div class="card shadow-sm border-light-subtle mb-4 p-4">
        <div class="row align-items-center mb-3 g-3">
            <div class="col-md-3">
                <label for="createRoomInput" class="form-label mb-0 fw-medium text-secondary">Create Room</label>
            </div>
            <div class="col-md-6">
                <input type="text" id="createRoomInput" class="form-control" placeholder="Enter room name...">
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100">Create Room</button>
            </div>
        </div>

        <div class="row align-items-center g-3">
            <div class="col-md-3">
                <label for="deleteRoomSelect" class="form-label mb-0 fw-medium text-secondary">Delete Room</label>
            </div>
            <div class="col-md-6">
                <select id="deleteRoomSelect" class="form-select">
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-danger w-100">Delete Room</button>
            </div>
        </div>

        <div class="row align-items-center g-3 mt-1">
            <div class="col-md-3">
                <label for="addUsertoRoomSelect" class="form-label mb-0 fw-medium text-secondary">Add User to Room</label>
            </div>
            <div class="col-md-6">
                <select id="addUsertoRoomSelect" class="form-select">
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-success w-100">Add User to Room</button>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-light-subtle mb-4 p-4">
        <div class="row align-items-center mb-3 g-3">
            <div class="col-md-3">
                <label for="selectRoomPublic" class="form-label mb-0 fw-medium text-secondary">Select Room</label>
            </div>
            <div class="col-md-6">
                <select id="selectRoomPublic" class="form-select">
                </select>
            </div>
            <div class="col-md-3">
            </div>
        </div>

        <div class="row align-items-center g-3">
            <div class="col-md-3">
                <label for="publicMessageInput" class="form-label mb-0 fw-medium text-secondary">Send Public Message</label>
            </div>
            <div class="col-md-6">
                <input type="text" id="publicMessageInput" class="form-control" placeholder="Type public message...">
            </div>
            <div class="col-md-3">
                <button class="btn btn-info text-white w-100">Send Public Message</button>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-light-subtle p-4">
        <div class="row align-items-center mb-3 g-3">
            <div class="col-md-3">
                <label for="selectUser" class="form-label mb-0 fw-medium text-secondary">Select User</label>
            </div>
            <div class="col-md-6">
                <select id="selectUser" class="form-select">
                    
                </select>
            </div>
            <div class="col-md-3">
            </div>
        </div>

        <div class="row align-items-center g-3">
            <div class="col-md-3">
                <label for="privateMessageInput" class="form-label mb-0 fw-medium text-secondary">Send Private Message</label>
            </div>
            <div class="col-md-6">
                <input type="text" id="privateMessageInput" class="form-control" placeholder="Type private message...">
            </div>
            <div class="col-md-3">
                <button class="btn btn-secondary w-100" style="background-color: #6c757d;">Send Private Message</button>
            </div>
        </div>
    </div>
    <div class="card shadow-sm border-light-subtle p-4 mt-4">
        <h5 class="card-title text-secondary mb-3 fw-semibold fs-6">Message List:</h5>

        <div class="p-3 bg-light rounded border border-light-subtle" style="max-height: 250px; overflow-y: auto;">
            <ul id="messageList" class="list-unstyled mb-0 d-flex flex-column gap-2 text-dark" style="font-size: 0.95rem;">

            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        // define connection
        var conn = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
        // start connection
        conn.start();

        conn.on("connected", (msg)=>{
            $("#messageList").append(`<li class="text-success">${msg}</li>`);
        });
        
        conn.on("disconnected", (msg)=>{
            $("#messageList").append(`<li class="text-danger">${msg}</li>`);
        });

        
    </script>
}