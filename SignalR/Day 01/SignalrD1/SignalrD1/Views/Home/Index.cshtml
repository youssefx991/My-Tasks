@model int
@{
    ViewData["Title"] = "Home Page";
}
<div>
     total visits : <span id="count"></span>
</div>
<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
@section Scripts {
    <script src="~/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        //define connection
        var con=new signalR.HubConnectionBuilder().withUrl("/visit").build();

        
        //define callback method
        con.on("updatevisitcount",(value)=>{document.getElementById("count").innerText=value;});

        //calling server method

        function callingserviceincreasecount(){
            con.send("increasecount");
        }
        //start connection
        con.start().then(callingserviceincreasecount);

    </script>
}