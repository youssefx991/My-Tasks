<div>
    <label>Sender</label><span>@User.Identity.Name</span><br />
    to: <input type="text" id="rec" /> <br />
    Message :<input type="text" id="txt" /> <br />
    <input type="button" value="send" onclick="send()" />
    <ul id="ulmess">

    </ul>
</div>
@section Scripts{
    <script src="~/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        var con =new signalR.HubConnectionBuilder().withUrl("/mychat").build();
        con.start();
        function send(){
            con.invoke("sendmesage","@User.Identity.Name",$("#rec").val(),$("#txt").val())
        }
        con.on("newmessage",(s,m)=>{$("#ulmess").append("<li>"+s+":"+m+"</li>")});
    </script>
}