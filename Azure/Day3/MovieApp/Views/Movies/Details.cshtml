@model MovieApp.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h1>@Model.Title</h1>

            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Director</dt>
                        <dd class="col-sm-9">@Model.Director</dd>

                        <dt class="col-sm-3">Release Year</dt>
                        <dd class="col-sm-9">@Model.ReleaseYear</dd>

                        <dt class="col-sm-3">Genre</dt>
                        <dd class="col-sm-9">@Model.Genre</dd>

                        <dt class="col-sm-3">Rating</dt>
                        <dd class="col-sm-9">@Model.Rating.ToString("F1") / 10</dd>
                    </dl>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
