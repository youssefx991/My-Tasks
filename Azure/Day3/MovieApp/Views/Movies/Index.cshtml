@model IEnumerable<MovieApp.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<div class="container mt-5">
    <h1 class="mb-4">Movies</h1>

    <a asp-action="Create" class="btn btn-primary mb-3">Create New Movie</a>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Title</th>
                        <th>Director</th>
                        <th>Release Year</th>
                        <th>Genre</th>
                        <th>Rating</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movie in Model)
                    {
                        <tr>
                            <td>@movie.Title</td>
                            <td>@movie.Director</td>
                            <td>@movie.ReleaseYear</td>
                            <td>@movie.Genre</td>
                            <td>@movie.Rating.ToString("F1")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No movies found. <a asp-action="Create">Create a new movie</a>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .btn-sm {
        margin-right: 5px;
    }
</style>
