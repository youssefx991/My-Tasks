<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Override any inherited (user/machine) feeds so restore only uses nuget.org.
       The machine had a private Azure DevOps feed that returns 401 Unauthorized. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
