@page "/empoverview_DB"

<h3>EmployeeOverview_DB</h3>

@code {

    [Inject]
    public IEmployeeDataService employeeDataService { get; set; }

    IEnumerable<Employee> AllEmployees { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AllEmployees = await employeeDataService.GetAllEmployees();
    }

}

@if (AllEmployees == null)
{
    <p>Loading................</p>
}
else
{
    <a href="@($"empnew_DB")" class="btn btn-primary"> New Emp </a>

    <table class="table">
        <thead>
            <tr>
                <th>Employee-ID</th>
                <th>Employee-FirstName</th>
                <th>Employee-LastName</th>
                <th> &nbsp; </th>
                <th> &nbsp; </th>
                <th> &nbsp; </th>

            </tr>
        </thead>
        <tbody>
            @foreach (var employee in AllEmployees)
            {
                <tr>
                    <td>@employee.EmployeeId</td>
                    <td>@employee.FirstName</td>
                    <td>@employee.LastName</td>

                    <td>
                        <a href="@($"empdetails_DB/{employee.EmployeeId}")" class="btn btn-primary"> Details </a>
                    </td>

                    <td>
                        <a href="@($"empedit_DB/{employee.EmployeeId}")" class="btn btn-secondary"> Edit </a>
                    </td>

                    <td>
                        <a href="@($"empdelt_DB/{employee.EmployeeId}")" class="btn btn-danger"> Delete </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}